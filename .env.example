# ==========================================================================
# Parmana — example environment file
#
# Copy to .env and fill in real values. Every variable below is read
# somewhere in this monorepo (grep for process.env.* across packages/,
# scripts/, and tests/helpers/). No real credentials belong in this file —
# every non-empty value here is a placeholder showing FORMAT only, never a
# real-looking one.
# ==========================================================================

# Runtime environment. Not validated against a fixed list in code (no
# parse function) — the only branch that actually changes behavior
# anywhere in this codebase is `NODE_ENV === "test"` vs everything else;
# conventionally development | test | production. Optional, defaults to
# "development".
NODE_ENV=development

# --------------------------------------------------------------------------
# Core boot
# --------------------------------------------------------------------------

# Directory containing policy files (policies/<name>/<version>/policy.json).
# Required — the process refuses to start without it.
PARMANA_POLICY_DIR=./policies

# Directory containing signing key material (default.private.pem,
# default.public.pem, gateway.private.pem, gateway.public.pem, ...).
# Required whenever NODE_ENV != test — the process refuses to start
# without it.
PARMANA_KEY_DIR=./keys

# JSON object of { "<keyId>": { "privateKeyPem": string, "publicKeyPem":
# string } }, materialized into PARMANA_KEY_DIR at boot for any file that
# doesn't already exist there. Optional — the "load key material from
# env" path for platforms with no persistent-volume/secret-file
# primitive; leave unset if you mount key files directly.
PARMANA_KEY_MATERIAL_JSON=

# Key id prefix for the Gateway's attestation-signing keypair (expects
# <PARMANA_KEY_DIR>/<id>.{private,public}.pem). Optional, defaults to
# "gateway".
PARMANA_GATEWAY_KEY_ID=gateway

# Identity this process presents to Execution Control as the Gateway
# (GatewayIdentity.gatewayId/publicIdentity — appears in every audit
# event and attestation this process signs). Distinct from
# PARMANA_GATEWAY_KEY_ID above (that's a key file prefix; this is the
# logical identity name). Set a distinct value per environment or
# tenant when running more than one logically distinct gateway against
# the same audit trail. Must match [A-Za-z0-9._-]+. Optional, defaults
# to "parmana-gateway".
PARMANA_GATEWAY_ID=parmana-gateway

# HTTP port the API server binds to. Optional, defaults to 3000 — PaaS
# platforms (Railway, Render, Fly, etc.) commonly inject this at deploy
# time.
PORT=3000

# Host/interface the API server binds to. Optional, defaults to "0.0.0.0".
HOST=

# Milliseconds the graceful-shutdown handler waits for in-flight requests
# to drain on SIGTERM/SIGINT before forcing exit. Optional, defaults to
# 10000.
SHUTDOWN_TIMEOUT_MS=

# Log verbosity. Not validated against a fixed list in code (no parse
# function, no logger library enforcing it) — any string is accepted
# as-is; conventionally debug | info | warn | error. Optional, defaults
# to "info".
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Storage
#
# REQUIRED TO START (even with PARMANA_STORAGE=memory): DATABASE_URL is
# read unconditionally by createNonceStore.ts/createCallerAuditSink.ts
# whenever NODE_ENV != test, independent of PARMANA_STORAGE — see that
# variable's own comment below for the traced startup path.
# --------------------------------------------------------------------------

# Storage backend for business-transaction/trust-record repositories.
# Valid values (enforced, packages/shared/src/config/StorageProviders.ts,
# via ConfigValidation.ts's parseStorageProvider): memory | postgres |
# supabase. Optional, defaults to "memory".
PARMANA_STORAGE=supabase

# Direct Postgres connection string. REQUIRED whenever NODE_ENV != test,
# regardless of PARMANA_STORAGE (NonceStore/CallerAuditSink/webhook
# stores key off NODE_ENV alone, not storage mode); also required when
# PARMANA_STORAGE=postgres or supabase for the business-transaction/
# trust-record repositories. Format placeholder only.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required only when PARMANA_STORAGE=supabase. Settings → API, in your
# Supabase dashboard. Format placeholder only.
SUPABASE_URL=https://your-project-ref.supabase.co

# Required only when PARMANA_STORAGE=supabase. The privileged
# service-role key (Supabase's current key format: sb_secret_*, not the
# older JWT format). Format placeholder only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Required only when PARMANA_STORAGE=supabase. The low-privilege
# anon/publishable key (sb_publishable_*). Format placeholder only.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opt-in required by tests/helpers/supabase-availability.ts before any
# Supabase-gated test suite runs against a live project. Optional; unset
# by default. WARNING: enables real writes to a live Supabase project
# during `npm test` — do not set for routine local runs.
# ALLOW_LIVE_SUPABASE=1

# --------------------------------------------------------------------------
# Cryptography
# --------------------------------------------------------------------------

# Signing mode. Valid values (enforced, CryptoAlgorithms.ts's
# CryptoModes, via parseCryptoMode): single | hybrid | pq. single: only
# PRIMARY_SIGNATURE_PROVIDER signs/verifies. hybrid: Trust Records and
# Receipts are additionally signed by SECONDARY_SIGNATURE_PROVIDER. pq is
# reserved, not read by any call site today. Optional, defaults to
# "single".
CRYPTO_MODE=single

# Primary signature algorithm. Valid values (enforced,
# CryptoAlgorithms.ts's SignatureAlgorithms, via
# parseSignatureAlgorithm): ed25519 | ecdsa-p256 | dilithium3 |
# dilithium5 | sphincs-plus. Optional, defaults to "ed25519".
PRIMARY_SIGNATURE_PROVIDER=ed25519

# Secondary signature algorithm — required only when CRYPTO_MODE=hybrid;
# must differ from PRIMARY_SIGNATURE_PROVIDER. Same valid-values list as
# PRIMARY_SIGNATURE_PROVIDER above. Its key material must exist at
# <PARMANA_KEY_DIR>/default-secondary.{private,public}.pem. Optional,
# unset by default.
SECONDARY_SIGNATURE_PROVIDER=

# Hash algorithm. Valid values (enforced, CryptoAlgorithms.ts's
# HashAlgorithms, via parseHashAlgorithm): sha256 | sha3-512 | blake3.
# Optional, defaults to "sha256".
HASH_PROVIDER=sha256

# Signing-key backend. Valid values (enforced, KeyProviders.ts, via
# parseKeyProvider): local | aws-kms | azure-key-vault | gcp-kms | hsm.
# Only "local" (FileKeyProvider) has an implementing class today —
# setting this to any of the other four values does nothing. Optional,
# defaults to "local".
KEY_PROVIDER=local

# --------------------------------------------------------------------------
# Execution Authorization / Trust
# --------------------------------------------------------------------------

# TTL, in seconds, applied to a signed Execution Authorization when the
# caller does not specify one. Free-form number. Optional, defaults to
# 120.
EXECUTION_AUTHORIZATION_TTL_SECONDS=120

# Trust record schema profile. Valid values (enforced,
# TrustProfiles.ts, via parseTrustProfile): v1 — the only value defined
# today. Optional, defaults to "v1".
TRUST_PROFILE=v1

# Receipt schema version. Not validated against a fixed list in code (no
# parse function) — free-form string, only "1" is meaningful today.
# Optional, defaults to "1".
RECEIPT_VERSION=1

# --------------------------------------------------------------------------
# Caller authentication (API)
# --------------------------------------------------------------------------

# JSON array of { "callerId": string, "keyHash": string (sha256 hex,
# 64 lowercase hex chars) } entries. Generate with `npm run
# generate:api-key -- --caller-id <id>`. Required unless
# PARMANA_AUTH_DISABLED=true — refuses to start with no keys configured
# and auth not explicitly disabled. Optional, defaults to "[]".
PARMANA_API_KEYS=[]

# Bypasses caller authentication entirely. Not enum-validated — checked
# via strict string equality (`=== "true"`); only the literal value
# "true" has any effect, anything else (including "false", "1", unset)
# means disabled=false. Local development only — NEVER set true in a
# real deployment: every request is executed with no caller identity
# check at all. Logs a loud warning at startup when true, and GET
# /ready's response carries authDisabled:true (plus a warning string)
# for the same reason — a field an operator's own monitoring/synthetic
# checks can assert on, not just a log line that's easy to miss. Left
# unset/commented out here deliberately (defaults to "false", the safe
# value) — a first-time operator who copies this file to .env without
# reading every line must not end up running with caller authentication
# off. Uncomment only for local development.
# PARMANA_AUTH_DISABLED=true

# --------------------------------------------------------------------------
# Rate limiting
#
# Both optional, with working defaults sized for a design-partner
# evaluation deployment, not high-volume production traffic. Free-form
# numbers, no enum.
# --------------------------------------------------------------------------

# POST /execute only, keyed by authenticated caller identity (not IP) —
# only enforced when caller-auth is enabled. Optional, defaults to 30.
RATE_LIMIT_EXECUTE_PER_MINUTE=30

# GET /health and GET /ready, keyed by IP. Optional, defaults to 300 —
# deliberately generous so PaaS health-check polling is never throttled.
RATE_LIMIT_HEALTH_PER_MINUTE=300

# --------------------------------------------------------------------------
# HubSpot connector (optional — connector simply not registered when unset)
# --------------------------------------------------------------------------

# HubSpot Private App token, production (NODE_ENV != test). Optional — if
# unset, the HubSpot connector is simply not registered. Format
# placeholder only.
#
# Long-lived, static credential with no built-in expiry (unlike the
# GitHub connector's ephemeral per-execution token) — rotate it
# periodically (recommended cadence: every 90 days, or immediately on
# suspected exposure) via HubSpot's app settings, and update
# HUBSPOT_PRIVATE_APP_TOKEN_ROTATED_AT below every time you do.
HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-private-app-token

# Date HUBSPOT_PRIVATE_APP_TOKEN was last rotated (ISO 8601, e.g.
# 2026-09-10). Optional, but without it startup logs a reminder that
# this token's age can't be tracked; past the 90-day recommended
# cadence, startup logs a staleness warning naming the actual age.
HUBSPOT_PRIVATE_APP_TOKEN_ROTATED_AT=

# HubSpot test-mode Private App token, used under NODE_ENV=test and by
# the gated live-integration suite. Must start with "pat-" (enforced;
# aborts before any network call if it doesn't). Scope to
# crm.objects.deals.read/write only. Optional, unset by default.
TEST_HUBSPOT_PRIVATE_APP_TOKEN=

# Opt-in required alongside TEST_HUBSPOT_PRIVATE_APP_TOKEN before the
# live HubSpot suite runs. Optional; unset by default. WARNING: makes
# real network calls to HubSpot's API and can mutate a real deal
# (reverted before the suite finishes) — do not set for routine local
# `npm test` runs.
# ALLOW_LIVE_HUBSPOT=1

# A real test deal id in the same HubSpot developer/test account,
# required only by the mutating deal-update case in the live suite.
# Optional — absent, only that one case skips.
# TEST_HUBSPOT_DEAL_ID=

# Test seam only: points the HubSpot connector at a hermetic mock server
# instead of HubSpot's real API (https://api.hubapi.com). Never set in
# production. Optional, unset by default.
# HUBSPOT_BASE_URL=

# --------------------------------------------------------------------------
# GitHub connector (optional — connector simply not registered when unset)
# --------------------------------------------------------------------------

# GitHub App id, installation id, and private key, production
# (NODE_ENV != test). All three are required together — if any is unset,
# the GitHub connector is simply not registered. The credential is
# ephemeral (docs/CLAIMS.md Claim 1): every execution mints a fresh,
# short-lived installation access token via a JWT-signed exchange; the
# App's private key itself is never sent to GitHub and never leaves
# GitHubAppCredentialProvider. Format placeholder only.
GITHUB_APP_ID=your-github-app-id
GITHUB_INSTALLATION_ID=your-github-app-installation-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-pem

# GitHub App id / installation id / private key used under NODE_ENV=test
# by the gated live-integration suite. All three are required together
# for the live suite to mint a real installation token. Optional, unset
# by default — the hermetic suite does not need these; it generates its
# own throwaway RSA keypair, since MockGitHubServer never verifies the
# App JWT's signature.
# TEST_GITHUB_APP_ID=
# TEST_GITHUB_INSTALLATION_ID=
# TEST_GITHUB_APP_PRIVATE_KEY=

# Opt-in required alongside the TEST_GITHUB_* triple before the live
# GitHub suite runs. Optional; unset by default. WARNING: makes real
# network calls to GitHub's API and can merge a real pull request
# (reverted before the suite finishes) — do not set for routine local
# `npm test` runs.
# ALLOW_LIVE_GITHUB=1

# A real test repository and pull request number in the same GitHub App
# installation, required only by the mutating merge case in the live
# suite. Optional — absent, only that one case skips.
# TEST_GITHUB_REPOSITORY=
# TEST_GITHUB_PULL_NUMBER=

# Test seam only: points the GitHub connector and credential provider at
# a hermetic mock server instead of GitHub's real API
# (https://api.github.com). Never set in production. Optional, unset by
# default.
# GITHUB_BASE_URL=

# --------------------------------------------------------------------------
# Retired — do not set
# --------------------------------------------------------------------------
# DATABASE_PROVIDER was replaced by PARMANA_STORAGE. Setting it causes
# startup to fail with an explicit error naming the replacement.

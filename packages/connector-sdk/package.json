{
  "name": "@parmana/connector-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Connector authoring contracts and reference implementations for Parmana, the authorization layer for AI execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@parmana/crypto": "0.1.0",
    "@parmana/envelope-verifier": "0.1.0",
    "@parmana/execution-system": "0.1.0",
    "@parmana/policy": "0.1.0",
    "@parmana/shared": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}

{
  "name": "@parmana/governance-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Policy Governance internal UI: propose/list/diff-review for pending policy changes. Read-only by design -- approve/reject stay CLI-only via scripts/sign-policy-change-step-up.ts, since step-up's security depends on the checker's private key never leaving their machine.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
